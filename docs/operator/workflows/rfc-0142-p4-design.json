      "id": "holder",
      "lane_id": "author",
      "objective": "Produce the leading proposal for RFC 0142 P4 (the one-shot `striatum daemon deploy`): a falsifiable implementation spec that RESOLVES OPEN QUESTIONS Q3 (per-step-atomic + resumable cursor vs. a stricter single-connection/single-transaction sub-protocol for some steps — the hard correctness core) and Q4 (is `striatum daemon deploy` a plain verb or a dogfooded Striatum run?), and specifies lifting auto-apply out of serve-boot, the deploy plan + deploy_cursor + deploy receipt, and revoking serving-role DDL. Name exact code sites (go/pkg/db/connection.go ConnectAndMigrate, go/pkg/db/schema_drift.go, go/pkg/db/owner.go, go/pkg/cli/localcommands/daemon.go) and state every load-bearing correctness claim as a falsifiable assertion. This is the published claim the falsifiers attack.",
      "phase_id": "dialogue",
      "role_id": "holder",
      "task_prompt": {
        "path": "prompts/collaboration_holder.md"
      },
      "title": "Hold leading proposal",
      "type": "build",
      "write_scope": {
        "allowed_paths": [
          "docs/operator/artifacts/rfc-0142-p4-design/dialogue/holder/"
        ],
        "forbidden_paths": [
          ".striatum/"
        ],
        "mode": "repo_write",
        "repo_write": true
      }
    },
