          "placement": "git_publication",
          "required": true
        }
      ],
      "id": "falsifier_1",
      "lane_id": "reviewer",
      "objective": "Read the published holder proposal and write a falsifying challenge for RFC 0142 P4, pressing hardest on the Q3 atomicity/resumability correctness core: any owner+runtime interleaving where a crash leaves an incoherent intermediate the fingerprint cannot classify as 'incomplete, resume'; any non-idempotent step; any non-transactional DDL (CREATE INDEX CONCURRENTLY, certain ALTERs) that breaks the per-step-atomic claim; and the bootstrapping paradox if deploy is itself a run (Q4).",
      "phase_id": "dialogue",
      "role_id": "falsifier",
      "task_prompt": {
        "path": "prompts/collaboration_falsifier.md"
      },
      "title": "Falsifier 1 (atomicity/resumability lens)",
      "type": "build",
      "write_scope": {
        "allowed_paths": [
          "docs/operator/artifacts/rfc-0142-p4-design/dialogue/falsifier_1/"
        ],
        "forbidden_paths": [
          ".striatum/"
        ],
        "mode": "repo_write",
        "repo_write": true
      }
    },
    {
      "expected_artifacts": [
        {
          "kind": "handoff",
          "logical_name": "falsifier_2",
          "path": "docs/operator/artifacts/rfc-0142-p4-design/dialogue/falsifier_2/FALSIFIER.md",
          "placement": "git_publication",
          "required": true
        }
      ],
      "id": "falsifier_2",
      "lane_id": "reviewer",
      "objective": "Read the published holder proposal and write a falsifying challenge for RFC 0142 P4, pressing hardest on the serve-boot decoupling and migration-safety: whether revoking serving-role DDL breaks any existing boot path; whether lifting ApplyMigrations out of ConnectAndMigrate regresses the P2 watermark interlock or the P3 drift gate; the downgrade direction; and operator-ergonomics of a deploy that must run before the new binary serves (ordering/lockout, the very #512-class lockout RFC 0143 also touches).",
      "phase_id": "dialogue",
      "role_id": "falsifier",
      "task_prompt": {
        "path": "prompts/collaboration_falsifier.md"
      },
      "title": "Falsifier 2 (decoupling/migration-safety lens)",
      "type": "build",
      "write_scope": {
        "allowed_paths": [
          "docs/operator/artifacts/rfc-0142-p4-design/dialogue/falsifier_2/"
        ],
        "forbidden_paths": [
          ".striatum/"
        ],
        "mode": "repo_write",
        "repo_write": true
      }
    },
    {
      "expected_artifacts": [
        {
          "kind": "collaboration_ledger",
          "logical_name": "collaboration_ledger_${cycle}",
          "path": "docs/operator/artifacts/rfc-0142-p4-design/dialogue/adjudicator/COLLABORATION_LEDGER_${cycle}.md",
          "placement": "git_publication",
          "required": true
        }
      ],
      "fresh_session_required": true,
      "id": "adjudicate",
      "lane_id": "author",
      "objective": "Read only the dialogue trajectory for RFC 0142 P4 and publish the collaboration ledger verdict (one of accept, accept_with_findings, needs_revision, reject — a clearing verdict is accept or accept_with_findings, never `clear`). needs_revision if the Q3 per-step-atomic+resumable-cursor contract is shown insufficient for any interleaving we actually ship without a concrete sub-protocol, or if Q4 is left unresolved, or if the serve-boot decoupling regresses P2/P3.",
      "phase_id": "dialogue",
      "role_id": "adjudicator",
      "task_prompt": {
        "path": "prompts/adjudicate_collaboration.md"
      },
      "title": "Adjudicate dialogue substance",
