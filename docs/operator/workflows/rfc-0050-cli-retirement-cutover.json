  "coordinator": {
    "role_id": "coordinator",
    "lane_id": "codex"
  },
  "parallelism": {
    "mode": "declared",
    "max_active_jobs": 2,
    "require_disjoint_write_scopes": true
  },
  "branch": {
    "mode": "confirm",
    "suggested_name": "striatum/rfc-0050-cli-retirement-cutover",
    "allow_dirty": true
  },
  "lanes": {
    "codex": {
      "adapter": "process",
      "command": [
        "bash",
        "-lc",
        "PYTHONPATH=src python3 -m striatum.cli skills install --profile all --scope user --force --json >/dev/null && export PATH=\"$PWD/.venv/bin:$PATH\" && exec .striatum/bin/codex-supervised-wrapper.sh"
      ],
      "model": "codex",
      "display_model": "Codex",
      "strategy_version": "2026-05-22",
      "supervision": {
        "compatible": true,
        "stdin_format": "newline_delimited_json",
        "wrapper_required": true
      }
    },
    "claude_code": {
      "adapter": "process",
      "command": [
        "bash",
        "-lc",
        "PYTHONPATH=src python3 -m striatum.cli skills install --profile all --scope user --force --json >/dev/null && export PATH=\"$PWD/.venv/bin:$PATH\" && exec .striatum/bin/claude-supervised-wrapper.sh"
      ],
      "model": "claude_code",
      "display_model": "Claude Code",
      "strategy_version": "2026-05-22",
      "supervision": {
        "compatible": "verify_pipe_behavior_first",
        "stdin_format": "prompt_text",
        "wrapper_required": true
      }
    }
  },
  "roles": {
    "coordinator": {
      "description": "Operator/control-plane role."
    },
    "classifier": {
      "description": "Classifies remaining CLI workflow-control verbs against MCP/UI parity and survivor categories."
    },
    "slice_planner": {
      "description": "Selects the next bounded MCP/UI parity slice and test gate."
    },
    "implementer": {
      "description": "Implements one bounded MCP/UI parity slice without deleting CLI workflow-control verbs before tests prove parity."
    },
    "reviewer": {
      "description": "Fresh-context reviewer for authority and regression risks."
    },
    "closer": {
      "description": "Closes the cutover slice with factual parity, validation, and remaining-gate status."
    }
  },
  "jobs": [
    {
      "id": "classify_cli_surface",
      "type": "synthesis",
      "title": "Classify CLI surface and parity",
      "role_id": "classifier",
      "lane_id": "claude_code",
      "fresh_session_required": true,
      "objective": "Refresh the RFC 0050 CLI retirement classification: map workflow-control verbs to daemon MCP methods, operator UI surfaces, survivor categories, parity gaps, and required tests before any hide/delete work.",
      "task_prompt": {
        "path": "docs/operator/workflows/rfc-0050-cli-retirement-cutover/prompts/classify_cli_surface.md"
      },
      "inputs": [
        "docs/operator/artifacts/active-runway-1-5/phase2/CLI_CUTOVER.md",
        "docs/CLI_REFERENCE.md",
        "src/striatum/cli/parser.py",
        "contracts/daemon_methods.json",
        "docs/architecture/COMMAND_AUTHORITY_MATRIX.md",
        "go/pkg/mcp/capabilities.go",
        "src/striatum/web/run_actions.py"
      ],
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "docs/operator/artifacts/rfc-0050-cli-retirement-cutover/classification/"
        ],
        "forbidden_paths": [
          ".striatum/"
        ]
      },
      "expected_artifacts": [
        {
          "logical_name": "cli_parity_map",
          "kind": "synthesis",
          "path": "docs/operator/artifacts/rfc-0050-cli-retirement-cutover/classification/CLI_PARITY_MAP.md",
          "required": true
        }
      ]
    },
    {
      "id": "select_next_parity_slice",
      "type": "synthesis",
      "title": "Select next MCP/UI parity slice",
      "role_id": "slice_planner",
      "lane_id": "codex",
      "fresh_session_required": true,
      "objective": "Choose the smallest next MCP/UI parity implementation slice from the refreshed classification and define its acceptance tests, authority guardrails, docs impact, and explicit no-CLI-deletion gate.",
      "task_prompt": {
        "path": "docs/operator/workflows/rfc-0050-cli-retirement-cutover/prompts/select_next_parity_slice.md"
      },
      "inputs": [
        "docs/operator/artifacts/rfc-0050-cli-retirement-cutover/classification/CLI_PARITY_MAP.md",
        "docs/operator/plans/rfc-0050-cli-retirement-cutover.md",
        "docs/rfcs/0050-go-daemon-http-sse-mcp.md",
        "docs/operator/BRIEF.md"
      ],
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "docs/operator/artifacts/rfc-0050-cli-retirement-cutover/parity-slice/"
        ],
        "forbidden_paths": [
          ".striatum/"
        ]
      },
      "expected_artifacts": [
        {
          "logical_name": "next_parity_slice",
          "kind": "synthesis",
          "path": "docs/operator/artifacts/rfc-0050-cli-retirement-cutover/parity-slice/NEXT_SLICE.md",
          "required": true
        }
      ]
    },
    {
      "id": "implement_next_parity_slice",
      "type": "build",
      "title": "Implement next MCP/UI parity slice",
      "role_id": "implementer",
      "lane_id": "codex",
      "fresh_session_required": true,
      "required_review_postures": [
        "custom:authority_boundary",
        "custom:regression_risk"
      ],
      "objective": "Implement only the selected MCP/UI parity slice and its tests. CLI workflow-control deletion or hiding is forbidden unless the classification and acceptance tests prove parity for that exact verb and CI-covering regression tests pass.",
      "task_prompt": {
        "path": "docs/operator/workflows/rfc-0050-cli-retirement-cutover/prompts/implement_next_parity_slice.md"
      },
      "inputs": [
        "docs/operator/artifacts/rfc-0050-cli-retirement-cutover/classification/CLI_PARITY_MAP.md",
        "docs/operator/artifacts/rfc-0050-cli-retirement-cutover/parity-slice/NEXT_SLICE.md"
      ],
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "contracts/",
          "go/",
          "src/striatum/",
          "tests/",
          "docs/MCP.md",
          "docs/SPEC.md",
          "docs/TODO.md",
          "docs/ROADMAP.md",
          "docs/CLI_REFERENCE.md",
          "docs/HOW_TO_AGENT.md",
          "docs/HOW_TO_HUMAN.md",
          "docs/operator/BRIEF.md",
          "docs/operator/plans/rfc-0050-cli-retirement-cutover.md",
          "docs/architecture/COMMAND_AUTHORITY_MATRIX.md",
          "docs/architecture/DAEMON_METHOD_TABLES.md",
          "docs/rfcs/0050-go-daemon-http-sse-mcp.md",
          "docs/operator/artifacts/rfc-0050-cli-retirement-cutover/build/"
        ],
        "forbidden_paths": [
          ".striatum/",
          ".venv/",
          "__pycache__/",
          "docs/operator/workflows/"
        ]
      },
      "expected_artifacts": [
        {
          "logical_name": "implementation_handoff",
          "kind": "handoff",
          "path": "docs/operator/artifacts/rfc-0050-cli-retirement-cutover/build/HANDOFF.md",
          "required": true
        }
      ]
    },
    {
      "id": "review_authority",
      "type": "review",
      "title": "Authority-boundary review",
      "role_id": "reviewer",
      "lane_id": "claude_code",
      "parallel_group": "implementation_review",
      "fresh_session_required": true,
      "reviewer_context_policy": "fresh",
      "review_posture": "custom:authority_boundary",
      "objective": "Review the parity slice for daemon/PostgreSQL authority, MCP/UI capability gates, hidden-method policy, and the explicit ban on CLI workflow-control deletion before parity tests pass.",
      "task_prompt": {
        "path": "docs/operator/workflows/rfc-0050-cli-retirement-cutover/prompts/review_authority.md"
      },
      "inputs": [
        "docs/operator/artifacts/rfc-0050-cli-retirement-cutover/classification/CLI_PARITY_MAP.md",
        "docs/operator/artifacts/rfc-0050-cli-retirement-cutover/parity-slice/NEXT_SLICE.md",
        "docs/operator/artifacts/rfc-0050-cli-retirement-cutover/build/HANDOFF.md"
      ],
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": [
          "docs/operator/artifacts/rfc-0050-cli-retirement-cutover/review/authority/"
        ],
        "forbidden_paths": [
          ".striatum/"
        ]
      },
      "expected_artifacts": [
        {
          "logical_name": "authority_review",
          "kind": "finding",
          "path": "docs/operator/artifacts/rfc-0050-cli-retirement-cutover/review/authority/REVIEW.md",
          "required": true
        }
      ]
    },
    {
      "id": "review_regression",
      "type": "review",
      "title": "Regression and parity-test review",
      "role_id": "reviewer",
      "lane_id": "claude_code",
      "parallel_group": "implementation_review",
      "fresh_session_required": true,
      "reviewer_context_policy": "fresh",
      "review_posture": "custom:regression_risk",
      "objective": "Review the parity slice for missing tests, MCP/UI behavior drift, web mutation-gate failures, daemon startup regressions, and any premature CLI hide/delete behavior.",
      "task_prompt": {
        "path": "docs/operator/workflows/rfc-0050-cli-retirement-cutover/prompts/review_regression.md"
      },
      "inputs": [
        "docs/operator/artifacts/rfc-0050-cli-retirement-cutover/classification/CLI_PARITY_MAP.md",
        "docs/operator/artifacts/rfc-0050-cli-retirement-cutover/parity-slice/NEXT_SLICE.md",
        "docs/operator/artifacts/rfc-0050-cli-retirement-cutover/build/HANDOFF.md"
      ],
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": [
          "docs/operator/artifacts/rfc-0050-cli-retirement-cutover/review/regression/"
        ],
        "forbidden_paths": [
          ".striatum/"
        ]
      },
      "expected_artifacts": [
        {
          "logical_name": "regression_review",
          "kind": "finding",
          "path": "docs/operator/artifacts/rfc-0050-cli-retirement-cutover/review/regression/REVIEW.md",
          "required": true
        }
      ]
    },
    {
      "id": "close_cutover_slice",
      "type": "synthesis",
      "title": "Close cutover slice",
      "role_id": "closer",
      "lane_id": "codex",
      "fresh_session_required": true,
      "objective": "Publish the cutover closure: accepted parity, tests run, verbs still blocked from CLI hiding/deletion, docs/skill follow-ups, and the next safe MCP/UI parity slice.",
      "task_prompt": {
        "path": "docs/operator/workflows/rfc-0050-cli-retirement-cutover/prompts/close_cutover_slice.md"
      },
      "inputs": [
        "docs/operator/artifacts/rfc-0050-cli-retirement-cutover/classification/CLI_PARITY_MAP.md",
        "docs/operator/artifacts/rfc-0050-cli-retirement-cutover/parity-slice/NEXT_SLICE.md",
        "docs/operator/artifacts/rfc-0050-cli-retirement-cutover/build/HANDOFF.md",
        "docs/operator/artifacts/rfc-0050-cli-retirement-cutover/review/authority/REVIEW.md",
        "docs/operator/artifacts/rfc-0050-cli-retirement-cutover/review/regression/REVIEW.md"
      ],
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "docs/operator/artifacts/rfc-0050-cli-retirement-cutover/final/"
        ],
        "forbidden_paths": [
          ".striatum/"
        ]
      },
      "expected_artifacts": [
        {
          "logical_name": "cutover_closure",
          "kind": "synthesis",
          "path": "docs/operator/artifacts/rfc-0050-cli-retirement-cutover/final/SUMMARY.md",
          "required": true
        }
      ]
