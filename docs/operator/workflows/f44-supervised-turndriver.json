{
  "schema_version": "striatum.workflow.v1",
  "workflow_id": "f44-supervised-turndriver",
  "workflow_version": "2026-05-26",
  "name": "F44: supervised turn-driver PATH + graceful generator failure (design + build, interrogating panel)",
  "branch": {
    "mode": "confirm",
    "suggested_name": "striatum/f44-supervised-turndriver",
    "allow_dirty": true
  },
  "coordinator": {"role_id": "coordinator", "lane_id": "claude_code"},
  "lanes": {
    "codex": {"adapter": "process", "display_model": "Codex", "command": ["codex", "exec", "-"], "capabilities": ["write", "review", "synthesis"]},
    "claude_code": {"adapter": "process", "display_model": "Claude", "command": ["claude", "--print"], "capabilities": ["write", "review", "synthesis"]}
  },
  "roles": {
    "coordinator": {"definition_path": "roles/coordinator.md"},
    "designer": {"definition_path": "roles/designer.md"},
    "synthesizer": {"definition_path": "roles/synthesizer.md"},
    "implementer": {"definition_path": "roles/implementer.md"},
    "reviewer": {"definition_path": "roles/reviewer.md"}
  },
  "context_docs": [
    {"path": "docs/operator/workflows/f44-supervised-turndriver/TASK.md", "required": true}
  ],
  "parallelism": {"mode": "declared", "max_active_jobs": 2, "require_disjoint_write_scopes": true},
  "jobs": [
    {
      "id": "design_codex", "type": "draft", "title": "Design (codex lane)", "role_id": "designer", "lane_id": "codex",
      "parallel_group": "design", "fresh_session_required": true,
      "objective": "Independent design proposal for F44. Do not coordinate with the other design lane.",
      "task_prompt": {"path": "prompts/design.md"},
      "write_scope": {"mode": "repo_write", "repo_write": true, "allowed_paths": ["docs/operator/workflows/f44-supervised-turndriver/artifacts/design/codex/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "codex_design", "kind": "handoff", "path": "docs/operator/workflows/f44-supervised-turndriver/artifacts/design/codex/DESIGN.md", "required": true}]
    },
    {
      "id": "design_claude", "type": "draft", "title": "Design (claude_code lane)", "role_id": "designer", "lane_id": "claude_code",
      "parallel_group": "design", "fresh_session_required": true,
      "objective": "Independent design proposal for F44. Do not coordinate with the other design lane.",
      "task_prompt": {"path": "prompts/design.md"},
      "write_scope": {"mode": "repo_write", "repo_write": true, "allowed_paths": ["docs/operator/workflows/f44-supervised-turndriver/artifacts/design/claude_code/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "claude_design", "kind": "handoff", "path": "docs/operator/workflows/f44-supervised-turndriver/artifacts/design/claude_code/DESIGN.md", "required": true}]
    },
    {
      "id": "synth", "type": "synthesis", "title": "Synthesize designs (interrogable)", "role_id": "synthesizer", "lane_id": "claude_code",
      "fresh_session_required": true, "interrogable": true,
      "objective": "Reconcile the two designs into one buildable synthesis. Stay live for the design-review panel to interrogate.",
      "task_prompt": {"path": "prompts/synth.md"},
      "write_scope": {"mode": "repo_write", "repo_write": true, "allowed_paths": ["docs/operator/workflows/f44-supervised-turndriver/artifacts/DESIGN_SYNTHESIS.md"], "forbidden_paths": [".striatum/", "docs/operator/workflows/f44-supervised-turndriver/artifacts/design/"]},
      "expected_artifacts": [{"logical_name": "design_synthesis", "kind": "synthesis", "path": "docs/operator/workflows/f44-supervised-turndriver/artifacts/DESIGN_SYNTHESIS.md", "required": true}]
    },
    {
      "id": "review_design_codex", "type": "review", "title": "Design review codex threat_model", "role_id": "reviewer", "lane_id": "codex",
      "parallel_group": "design_review", "fresh_session_required": true, "reviewer_context_policy": "fresh", "reviewer_access_scope": "document_only", "review_posture": "threat_model",
      "objective": "Threat-model the synthesis and interrogate the live synthesizer before a verdict.",
      "task_prompt": {"path": "prompts/review_design.md"},
      "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["docs/operator/workflows/f44-supervised-turndriver/artifacts/review/design/codex/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "design_review_codex", "kind": "finding", "path": "docs/operator/workflows/f44-supervised-turndriver/artifacts/review/design/codex/REVIEW.md", "required": true}]
    },
    {
      "id": "review_design_claude", "type": "review", "title": "Design review claude ergonomics_dx", "role_id": "reviewer", "lane_id": "claude_code",
      "parallel_group": "design_review", "fresh_session_required": true, "reviewer_context_policy": "fresh", "reviewer_access_scope": "document_only", "review_posture": "ergonomics_dx",
      "objective": "Review the synthesis for ergonomics/DX and interrogate the live synthesizer before a verdict.",
      "task_prompt": {"path": "prompts/review_design.md"},
      "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["docs/operator/workflows/f44-supervised-turndriver/artifacts/review/design/claude_code/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "design_review_claude", "kind": "finding", "path": "docs/operator/workflows/f44-supervised-turndriver/artifacts/review/design/claude_code/REVIEW.md", "required": true}]
    },
    {
      "id": "implement", "type": "build", "title": "Implement F44 fix (interrogable)", "role_id": "implementer", "lane_id": "codex",
      "interrogable": true, "required_review_postures": ["threat_model", "ergonomics_dx"],
      "objective": "Implement the synthesized F44 fix with tests. Land only converged scope, write a handoff, stay live for the build-review panel.",
      "task_prompt": {"path": "prompts/implement.md"},
      "write_scope": {"mode": "repo_write", "repo_write": true,
        "allowed_paths": ["go/", "docs/rfcs/", "docs/DECISION_LOG.md", "docs/TODO.md", "docs/operator/workflows/f44-supervised-turndriver/artifacts/build/"],
        "forbidden_paths": [".striatum/", "docs/operator/workflows/f44-supervised-turndriver/artifacts/design/", "docs/operator/workflows/f44-supervised-turndriver/artifacts/review/"]},
      "expected_artifacts": [{"logical_name": "build_handoff", "kind": "handoff", "path": "docs/operator/workflows/f44-supervised-turndriver/artifacts/build/HANDOFF.md", "required": true}]
    },
    {
      "id": "review_build_codex", "type": "review", "title": "Build review codex threat_model", "role_id": "reviewer", "lane_id": "codex",
      "parallel_group": "build_review", "fresh_session_required": true, "reviewer_context_policy": "fresh", "reviewer_access_scope": "document_only", "review_posture": "threat_model",
      "objective": "Threat-model the implementation and interrogate the live implementer before a verdict.",
      "task_prompt": {"path": "prompts/review_build.md"},
      "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["docs/operator/workflows/f44-supervised-turndriver/artifacts/review/build/codex/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "build_review_codex", "kind": "finding", "path": "docs/operator/workflows/f44-supervised-turndriver/artifacts/review/build/codex/REVIEW.md", "required": true}]
    },
    {
      "id": "review_build_claude", "type": "review", "title": "Build review claude ergonomics_dx", "role_id": "reviewer", "lane_id": "claude_code",
      "parallel_group": "build_review", "fresh_session_required": true, "reviewer_context_policy": "fresh", "reviewer_access_scope": "document_only", "review_posture": "ergonomics_dx",
      "objective": "Review the implementation for ergonomics/DX, run the verification commands, and interrogate the live implementer before a verdict.",
      "task_prompt": {"path": "prompts/review_build.md"},
      "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["docs/operator/workflows/f44-supervised-turndriver/artifacts/review/build/claude_code/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "build_review_claude", "kind": "finding", "path": "docs/operator/workflows/f44-supervised-turndriver/artifacts/review/build/claude_code/REVIEW.md", "required": true}]
    }
  ],
  "edges": [
    {"from": "design_codex", "to": "synth", "on": "completed"},
    {"from": "design_claude", "to": "synth", "on": "completed"},
    {"from": "synth", "to": "review_design_codex", "on": "completed"},
    {"from": "synth", "to": "review_design_claude", "on": "completed"},
    {"from": "review_design_codex", "to": "implement", "on": "completed"},
    {"from": "review_design_claude", "to": "implement", "on": "completed"},
    {"from": "implement", "to": "review_build_codex", "on": "completed"},
    {"from": "implement", "to": "review_build_claude", "on": "completed"}
  ],
  "cycles": [
    {"from": "review_design_codex", "to": "synth", "on_verdict": "needs_revision", "max_iterations": 2, "allow_same_lane": true},
    {"from": "review_design_claude", "to": "synth", "on_verdict": "needs_revision", "max_iterations": 2, "allow_same_lane": true},
    {"from": "review_build_codex", "to": "implement", "on_verdict": "needs_revision", "max_iterations": 2, "allow_same_lane": true},
    {"from": "review_build_claude", "to": "implement", "on_verdict": "needs_revision", "max_iterations": 2, "allow_same_lane": true}
  ]
}
