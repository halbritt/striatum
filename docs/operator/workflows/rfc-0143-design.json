    {
      "from": "falsifier_2",
      "on": "completed",
      "to": "adjudicate"
    },
    {
      "from": "adjudicate",
      "on": "completed",
      "to": "commit_proposal"
    },
    {
      "from": "commit_proposal",
      "on": "completed",
      "to": "final_summary"
    }
  ],
  "jobs": [
    {
      "expected_artifacts": [
        {
          "kind": "handoff",
          "logical_name": "holder_handoff",
          "path": "docs/operator/artifacts/rfc-0143-design/dialogue/holder/HOLDER.md",
          "placement": "git_publication",
          "required": true
        }
      ],
      "id": "holder",
      "lane_id": "author",
      "objective": "Produce the leading proposal for RFC 0143: a falsifiable implementation spec that RESOLVES THE FOUR OPEN QUESTIONS (which trust-model option 1-4 or combination; the surviving capability set + lifecycle of any new credential class; where the survival mechanism lives in source; and the legible-failure fallback) WITHOUT widening who can read the daemon's full-authority bootstrap admin client-token. Name the exact code sites (go/pkg/mutations/session_token.go, go/pkg/agentloop/token.go + endpoint.go, go/pkg/admin/bootstrap.go, go/cmd/striatumd/main.go boot-epoch publish) and state every load-bearing security claim as a falsifiable assertion. This is the published claim the falsifiers attack.",
      "phase_id": "dialogue",
      "role_id": "holder",
      "task_prompt": {
        "path": "prompts/collaboration_holder.md"
      },
      "title": "Hold leading proposal",
      "type": "build",
      "write_scope": {
        "allowed_paths": [
          "docs/operator/artifacts/rfc-0143-design/dialogue/holder/"
        ],
        "forbidden_paths": [
          ".striatum/"
        ],
        "mode": "repo_write",
        "repo_write": true
      }
    },
    {
      "expected_artifacts": [
        {
          "kind": "handoff",
          "logical_name": "falsifier_1",
          "path": "docs/operator/artifacts/rfc-0143-design/dialogue/falsifier_1/FALSIFIER.md",
          "placement": "git_publication",
          "required": true
        }
      ],
      "id": "falsifier_1",
      "lane_id": "reviewer",
      "objective": "Read the published holder proposal and write a falsifying challenge for RFC 0143 lane credential survival across a boot-epoch rotation, pressing hardest on the security/authz blast radius: any path that widens admin-token exposure, any durable lane-readable token file that can outlive or be replayed past its session, any split-brain where a reseal token writes into a session the daemon has retired, and any Open Question 'resolved' without a concrete mechanism.",
      "phase_id": "dialogue",
      "role_id": "falsifier",
      "task_prompt": {
        "path": "prompts/collaboration_falsifier.md"
      },
      "title": "Falsifier 1 (security/authz lens)",
      "type": "build",
      "write_scope": {
        "allowed_paths": [
          "docs/operator/artifacts/rfc-0143-design/dialogue/falsifier_1/"
        ],
        "forbidden_paths": [
          ".striatum/"
        ],
        "mode": "repo_write",
        "repo_write": true
      }
    },
    {
      "expected_artifacts": [
        {
          "kind": "handoff",
          "logical_name": "falsifier_2",
          "path": "docs/operator/artifacts/rfc-0143-design/dialogue/falsifier_2/FALSIFIER.md",
          "placement": "git_publication",
          "required": true
        }
      ],
      "id": "falsifier_2",
      "lane_id": "reviewer",
      "objective": "Read the published holder proposal and write a falsifying challenge for RFC 0143 lane credential survival across a boot-epoch rotation, pressing hardest on operator-ergonomics and lifecycle correctness: revocation/invalidation on session close, TTL bounds, file ownership/mode, the boot-epoch-invalidation interaction, and whether the legible-failure fallback truly makes the failure loud (self-escalating) rather than swapping one silent exit for another.",
      "phase_id": "dialogue",
      "role_id": "falsifier",
      "task_prompt": {
        "path": "prompts/collaboration_falsifier.md"
      },
      "title": "Falsifier 2 (lifecycle/ergonomics lens)",
      "type": "build",
      "write_scope": {
        "allowed_paths": [
          "docs/operator/artifacts/rfc-0143-design/dialogue/falsifier_2/"
        ],
        "forbidden_paths": [
          ".striatum/"
        ],
        "mode": "repo_write",
        "repo_write": true
      }
    },
    {
      "expected_artifacts": [
        {
          "kind": "collaboration_ledger",
          "logical_name": "collaboration_ledger_${cycle}",
          "path": "docs/operator/artifacts/rfc-0143-design/dialogue/adjudicator/COLLABORATION_LEDGER_${cycle}.md",
          "placement": "git_publication",
          "required": true
        }
      ],
      "fresh_session_required": true,
      "id": "adjudicate",
      "lane_id": "author",
      "objective": "Read only the dialogue trajectory for RFC 0143 lane credential survival across a boot-epoch rotation and publish the collaboration ledger verdict (one of accept, accept_with_findings, needs_revision, reject — a clearing verdict is accept or accept_with_findings, never `clear`). needs_revision if any material security challenge stands unrebutted, especially any admin-token-widening or replayable-file path.",
      "phase_id": "dialogue",
      "role_id": "adjudicator",
      "task_prompt": {
        "path": "prompts/adjudicate_collaboration.md"
      },
      "title": "Adjudicate dialogue substance",
      "type": "phase_synthesis",
      "write_scope": {
        "allowed_paths": [
          "docs/operator/artifacts/rfc-0143-design/dialogue/adjudicator/"
        ],
        "forbidden_paths": [
          ".striatum/"
        ],
        "mode": "repo_write",
        "repo_write": true
      }
    },
    {
      "expected_artifacts": [
        {
          "kind": "synthesis",
          "logical_name": "commit_proposal",
          "path": "docs/operator/artifacts/rfc-0143-design/commit/proposal/PROPOSAL.md",
          "placement": "git_publication",
          "required": true
        }
      ],
      "id": "commit_proposal",
      "lane_id": "author",
      "objective": "Publish the cleared falsifiable implementation spec (resolving all four Open Questions, with the chosen trust-model option and its exact mechanism) only after the adjudicator ledger records a clearing verdict; this SPEC is the artifact the rfc-0143-build run consumes. It MUST flag that the chosen option is a security/authz trust-model change requiring maintainer ratification before the build lands.",
      "phase_id": "commit",
      "role_id": "committer",
      "task_prompt": {
        "path": "prompts/collaboration_commit.md"
      },
      "title": "Commit falsification-cleared proposal",
      "type": "synthesis",
      "write_scope": {
        "allowed_paths": [
          "docs/operator/artifacts/rfc-0143-design/commit/proposal/"
        ],
        "forbidden_paths": [
          ".striatum/"
        ],
        "mode": "repo_write",
        "repo_write": true
      }
    },
    {
      "expected_artifacts": [
        {
          "kind": "synthesis",
          "logical_name": "final_summary",
          "path": "docs/operator/artifacts/rfc-0143-design/commit/final/FINAL_SUMMARY.md",
          "placement": "git_publication",
          "required": true
        }
      ],
      "id": "final_summary",
      "lane_id": "reviewer",
      "objective": "Summarize the cleared collaboration gate and downstream publication.",
      "phase_id": "commit",
      "role_id": "adjudicator",
      "task_prompt": {
        "path": "prompts/collaboration_final_summary.md"
      },
      "title": "Finalize collaboration run",
      "type": "phase_synthesis",
      "write_scope": {
        "allowed_paths": [
          "docs/operator/artifacts/rfc-0143-design/commit/final/"
        ],
        "forbidden_paths": [
          ".striatum/"
        ],
        "mode": "repo_write",
        "repo_write": true
      }
    }
  ],
  "lanes": {
    "author": {
      "adapter": "process",
      "adapter_capabilities": {
        "agent_loop": true
      },
      "capabilities": [
        "write",
        "review",
        "synthesis"
      ],
      "command": [
        "claude",
        "--dangerously-skip-permissions",
        "--model",
        "claude-opus-4-8"
      ],
      "display_model": "author",
      "supervision": {
        "transport": "pty_helper"
      },
      "worktree_isolation": "per_job"
    },
    "reviewer": {
      "adapter": "process",
      "adapter_capabilities": {
        "agent_loop": true
      },
      "capabilities": [
        "write",
        "review",
        "synthesis"
      ],
      "command": [
        "codex",
        "--yolo"
      ],
      "display_model": "reviewer",
      "supervision": {
        "transport": "pty_helper"
      },
      "worktree_isolation": "per_job"
    }
  },
  "name": "rfc-0143-design",
  "parallelism": {
    "max_active_jobs": 1,
    "mode": "declared",
    "require_disjoint_write_scopes": true
  },
  "phases": [
    {
      "description": "Preserved-context challenge and adjudication",
      "id": "dialogue",
      "name": "Dialogue",
      "synthesis_job_id": "adjudicate"
