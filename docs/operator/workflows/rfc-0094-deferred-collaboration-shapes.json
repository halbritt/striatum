    {
      "id": "implement",
      "type": "build",
      "title": "Implement RFC 0094 (interrogable)",
      "role_id": "implementer",
      "lane_id": "codex",
      "interrogable": true,
      "required_review_postures": ["threat_model", "ergonomics_dx", "devils_advocate"],
      "objective": "Implement the converged RFC 0094 slice per the synthesis (slices 1-2 target: post_dialog_hook + synaptic_prune, Check-B + collaboration_ledger v1.1 + anti-theater corpus; slices 3-4 stretch). Land only convergent changes with tests green; write the handoff; stay live for the build panel.",
      "task_prompt": {"path": "prompts/implement.md"},
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "go/",
          "examples/",
          "docs/reference/workflow-types.md",
          "docs/reference/ubiquitous-language.md",
          "docs/reference/spec.md",
          "docs/rfcs/0094-deferred-collaboration-shapes-fog-of-war-and-synaptic-prune.md",
