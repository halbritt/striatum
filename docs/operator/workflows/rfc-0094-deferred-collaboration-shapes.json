{
  "schema_version": "striatum.workflow.v1",
  "workflow_id": "rfc-0094-deferred-collaboration-shapes",
  "workflow_version": "2026-05-30",
  "name": "RFC 0094 deferred collaboration shapes — 3-lane design + build",
  "branch": {
    "mode": "auto",
    "suggested_name": "striatum/rfc-0094-deferred-collaboration-shapes",
    "allow_dirty": true
  },
  "coordinator": {"role_id": "coordinator", "lane_id": "claude_code"},
  "lanes": {
    "codex": {
      "adapter": "process",
      "display_model": "Codex GPT-5.5 xhigh",
      "command": ["codex", "--model", "gpt-5.5", "-c", "model_reasoning_effort=\"xhigh\"", "--dangerously-bypass-approvals-and-sandbox"],
      "adapter_capabilities": {"agent_loop": true},
      "capabilities": ["write", "review", "synthesis", "interrogate"]
    },
    "claude_code": {
      "adapter": "process",
      "display_model": "Claude Opus 4.8",
      "command": ["claude", "--model", "claude-opus-4-8", "--permission-mode", "bypassPermissions"],
      "adapter_capabilities": {"agent_loop": true},
      "capabilities": ["write", "review", "synthesis", "interrogate"]
    },
    "agy": {
      "adapter": "process",
      "display_model": "Gemini 3.5 Flash High",
      "command": ["agy", "--dangerously-skip-permissions"],
      "adapter_capabilities": {"agent_loop": true},
      "capabilities": ["write", "review"]
    }
  },
  "roles": {
    "coordinator": {"definition_path": "roles/coordinator.md"},
    "designer": {"definition_path": "roles/designer.md"},
    "synthesizer": {"definition_path": "roles/synthesizer.md"},
    "implementer": {"definition_path": "roles/implementer.md"},
    "reviewer": {"definition_path": "roles/reviewer.md"}
  },
  "context_docs": [
    {"path": "docs/operator/workflows/rfc-0094-deferred-collaboration-shapes/TASK.md", "required": true},
    {"path": "docs/rfcs/0094-deferred-collaboration-shapes-fog-of-war-and-synaptic-prune.md", "required": true},
    {"path": "docs/rfcs/0093-structured-live-collaboration-workflow-shapes.md", "required": true},
    {"path": "docs/rfcs/0086-multiparty-conversation.md", "required": false},
    {"path": "docs/rfcs/0082-interrogation-sessions.md", "required": false},
    {"path": "docs/rfcs/0034-workflow-generator-and-template-catalog.md", "required": false}
  ],
  "parallelism": {"mode": "declared", "max_active_jobs": 3, "require_disjoint_write_scopes": true},
  "allow_same_model_review_pairing": true,
  "jobs": [
    {
      "id": "design_codex",
      "type": "draft",
      "title": "Design (codex lane)",
      "role_id": "designer",
      "lane_id": "codex",
      "parallel_group": "design",
      "fresh_session_required": true,
      "objective": "Produce an independent implementation design for RFC 0094 (post_dialog_hook + synaptic_prune, Check-B + collaboration_ledger v1.1, work-packet type sequencing + fog_of_war_review, second-adjudicator). Prioritize the smallest-blast-radius slices 1-2. Do not coordinate with the other design lanes.",
      "task_prompt": {"path": "prompts/design.md"},
      "write_scope": {"mode": "repo_write", "repo_write": true, "allowed_paths": ["docs/operator/workflows/rfc-0094-deferred-collaboration-shapes/artifacts/design/codex/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "codex_design", "kind": "handoff", "path": "docs/operator/workflows/rfc-0094-deferred-collaboration-shapes/artifacts/design/codex/DESIGN.md", "required": true}]
    },
    {
      "id": "design_claude",
      "type": "draft",
      "title": "Design (claude_code lane)",
      "role_id": "designer",
      "lane_id": "claude_code",
      "parallel_group": "design",
      "fresh_session_required": true,
      "objective": "Produce an independent implementation design for RFC 0094. Prioritize the smallest-blast-radius slices 1-2. Do not coordinate with the other design lanes.",
      "task_prompt": {"path": "prompts/design.md"},
      "write_scope": {"mode": "repo_write", "repo_write": true, "allowed_paths": ["docs/operator/workflows/rfc-0094-deferred-collaboration-shapes/artifacts/design/claude_code/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "claude_design", "kind": "handoff", "path": "docs/operator/workflows/rfc-0094-deferred-collaboration-shapes/artifacts/design/claude_code/DESIGN.md", "required": true}]
    },
