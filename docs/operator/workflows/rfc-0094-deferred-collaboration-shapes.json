      "title": "Design review codex threat_model",
      "role_id": "reviewer",
      "lane_id": "codex",
      "parallel_group": "design_review",
      "fresh_session_required": true,
      "reviewer_context_policy": "fresh",
      "reviewer_access_scope": "document_only",
      "review_posture": "threat_model",
      "objective": "Threat-model the design synthesis and interrogate the live synthesizer before a verdict.",
      "task_prompt": {"path": "prompts/review_design.md"},
      "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["docs/operator/workflows/rfc-0094-deferred-collaboration-shapes/artifacts/review/design/codex/"], "forbidden_paths": [".striatum/"]},
