      "fresh_session_required": true,
      "reviewer_context_policy": "fresh",
      "reviewer_access_scope": "repo_level",
      "review_posture": "threat_model",
      "objective": "Threat-model the implementation, run the verification commands, and interrogate the live implementer before a verdict.",
      "task_prompt": {"path": "prompts/review_build.md"},
      "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["docs/operator/workflows/rfc-0094-deferred-collaboration-shapes/artifacts/review/build/codex/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "build_review_codex", "kind": "finding", "path": "docs/operator/workflows/rfc-0094-deferred-collaboration-shapes/artifacts/review/build/codex/REVIEW.md", "required": true}]
