      "id": "synth",
      "type": "synthesis",
      "title": "Synthesize designs (interrogable)",
      "role_id": "synthesizer",
      "lane_id": "claude_code",
      "fresh_session_required": true,
      "interrogable": true,
      "objective": "Reconcile the three design proposals into a single buildable synthesis for RFC 0094, sliced smallest-blast-radius first. Stay live after completing so the design panel can interrogate your preserved reasoning.",
      "task_prompt": {"path": "prompts/synth.md"},
      "write_scope": {"mode": "repo_write", "repo_write": true, "allowed_paths": ["docs/operator/workflows/rfc-0094-deferred-collaboration-shapes/artifacts/DESIGN_SYNTHESIS.md"], "forbidden_paths": [".striatum/", "docs/operator/workflows/rfc-0094-deferred-collaboration-shapes/artifacts/design/"]},
