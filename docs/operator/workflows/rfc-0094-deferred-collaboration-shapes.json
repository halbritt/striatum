      "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["docs/operator/workflows/rfc-0094-deferred-collaboration-shapes/artifacts/review/design/claude_code/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "design_review_claude", "kind": "finding", "path": "docs/operator/workflows/rfc-0094-deferred-collaboration-shapes/artifacts/review/design/claude_code/REVIEW.md", "required": true}]
    },
    {
      "id": "review_design_agy",
      "type": "review",
      "title": "Design review agy devils_advocate",
      "role_id": "reviewer",
      "lane_id": "agy",
      "parallel_group": "design_review",
      "fresh_session_required": true,
      "reviewer_context_policy": "fresh",
      "reviewer_access_scope": "document_only",
      "review_posture": "devils_advocate",
      "objective": "Adversarially probe the design synthesis and render a verdict.",
      "task_prompt": {"path": "prompts/review_design.md"},
      "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["docs/operator/workflows/rfc-0094-deferred-collaboration-shapes/artifacts/review/design/agy/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "design_review_agy", "kind": "finding", "path": "docs/operator/workflows/rfc-0094-deferred-collaboration-shapes/artifacts/review/design/agy/REVIEW.md", "required": true}]
