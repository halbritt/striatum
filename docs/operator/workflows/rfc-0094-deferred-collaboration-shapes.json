      "id": "design_agy",
      "type": "draft",
      "title": "Design (agy lane)",
      "role_id": "designer",
      "lane_id": "agy",
      "parallel_group": "design",
      "fresh_session_required": true,
      "objective": "Produce an independent implementation design for RFC 0094. Prioritize the smallest-blast-radius slices 1-2. Do not coordinate with the other design lanes.",
      "task_prompt": {"path": "prompts/design.md"},
      "write_scope": {"mode": "repo_write", "repo_write": true, "allowed_paths": ["docs/operator/workflows/rfc-0094-deferred-collaboration-shapes/artifacts/design/agy/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "agy_design", "kind": "handoff", "path": "docs/operator/workflows/rfc-0094-deferred-collaboration-shapes/artifacts/design/agy/DESIGN.md", "required": true}]
    },
