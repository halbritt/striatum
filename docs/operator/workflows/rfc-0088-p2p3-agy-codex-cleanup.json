{
  "schema_version": "striatum.workflow.v1",
  "workflow_id": "rfc-0088-p2p3-agy-codex-cleanup",
  "workflow_version": "2026-05-28",
  "name": "RFC 0088 P2+P3: agy lane + gemini removal + codex cutover + delete wrapper/turn-driver (design + build, interrogating design panel)",
  "branch": {
    "mode": "confirm",
    "suggested_name": "striatum/rfc-0088-p2p3-agy-codex-cleanup",
    "allow_dirty": true
  },
  "coordinator": {"role_id": "coordinator", "lane_id": "claude_code"},
  "lanes": {
    "codex": {
      "adapter": "process",
      "display_model": "Codex GPT-5.5 xhigh",
      "command": ["codex", "exec", "--model", "gpt-5.5", "-c", "model_reasoning_effort=\"xhigh\"", "-"],
      "supervision": {"transport": "pipe", "stdin_delivery": "one_shot_eof"},
      "capabilities": ["write", "review", "synthesis", "interrogate"]
    },
    "claude_code": {
      "adapter": "process",
      "display_model": "Claude Opus 4.7",
      "command": ["claude", "--model", "claude-opus-4-7", "--permission-mode", "bypassPermissions"],
      "adapter_capabilities": {"agent_loop": true},
      "capabilities": ["write", "review", "synthesis", "interrogate"]
    }
  },
  "roles": {
    "coordinator": {"definition_path": "roles/coordinator.md"},
    "designer": {"definition_path": "roles/designer.md"},
    "synthesizer": {"definition_path": "roles/synthesizer.md"},
    "implementer": {"definition_path": "roles/implementer.md"},
    "reviewer": {"definition_path": "roles/reviewer.md"}
  },
  "context_docs": [
    {"path": "docs/operator/workflows/rfc-0088-p2p3-agy-codex-cleanup/TASK.md", "required": true},
    {"path": "docs/rfcs/0088-deprecate-print-interactive-pty-lanes-agy-migration.md", "required": true},
    {"path": "docs/operator/workflows/rfc-0088-p1-pty-foundation/TASK.md", "required": false}
  ],
  "parallelism": {"mode": "declared", "max_active_jobs": 2, "require_disjoint_write_scopes": true},
  "jobs": [
    {
      "id": "design_codex", "type": "draft", "title": "Design (codex lane)", "role_id": "designer", "lane_id": "codex",
      "parallel_group": "design", "fresh_session_required": true,
      "objective": "Independent design proposal for RFC 0088 P2+P3. Do not coordinate with the other design lane.",
      "task_prompt": {"path": "prompts/design.md"},
      "write_scope": {"mode": "repo_write", "repo_write": true, "allowed_paths": ["docs/operator/workflows/rfc-0088-p2p3-agy-codex-cleanup/artifacts/design/codex/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "codex_design", "kind": "handoff", "path": "docs/operator/workflows/rfc-0088-p2p3-agy-codex-cleanup/artifacts/design/codex/DESIGN.md", "required": true}]
    },
    {
      "id": "design_claude", "type": "draft", "title": "Design (claude_code lane)", "role_id": "designer", "lane_id": "claude_code",
      "parallel_group": "design", "fresh_session_required": true,
      "objective": "Independent design proposal for RFC 0088 P2+P3. Do not coordinate with the other design lane.",
      "task_prompt": {"path": "prompts/design.md"},
      "write_scope": {"mode": "repo_write", "repo_write": true, "allowed_paths": ["docs/operator/workflows/rfc-0088-p2p3-agy-codex-cleanup/artifacts/design/claude_code/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "claude_design", "kind": "handoff", "path": "docs/operator/workflows/rfc-0088-p2p3-agy-codex-cleanup/artifacts/design/claude_code/DESIGN.md", "required": true}]
    },
    {
      "id": "synth", "type": "synthesis", "title": "Synthesize designs (interrogable)", "role_id": "synthesizer", "lane_id": "claude_code",
      "fresh_session_required": true, "interrogable": true,
      "objective": "Reconcile the two designs into one buildable synthesis covering P2 (agy + gemini removal) AND P3 (codex cutover + wrapper/turn-driver deletion). Stay live for the design-review panel to interrogate.",
      "task_prompt": {"path": "prompts/synth.md"},
      "write_scope": {"mode": "repo_write", "repo_write": true, "allowed_paths": ["docs/operator/workflows/rfc-0088-p2p3-agy-codex-cleanup/artifacts/DESIGN_SYNTHESIS.md"], "forbidden_paths": [".striatum/", "docs/operator/workflows/rfc-0088-p2p3-agy-codex-cleanup/artifacts/design/"]},
      "expected_artifacts": [{"logical_name": "design_synthesis", "kind": "synthesis", "path": "docs/operator/workflows/rfc-0088-p2p3-agy-codex-cleanup/artifacts/DESIGN_SYNTHESIS.md", "required": true}]
    },
    {
      "id": "review_design_codex", "type": "review", "title": "Design review codex threat_model", "role_id": "reviewer", "lane_id": "codex",
      "parallel_group": "design_review", "fresh_session_required": true, "reviewer_context_policy": "fresh", "reviewer_access_scope": "document_only", "review_posture": "threat_model",
      "objective": "Threat-model the synthesis and interrogate the live synthesizer before a verdict.",
      "task_prompt": {"path": "prompts/review_design.md"},
      "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["docs/operator/workflows/rfc-0088-p2p3-agy-codex-cleanup/artifacts/review/design/codex/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "design_review_codex", "kind": "finding", "path": "docs/operator/workflows/rfc-0088-p2p3-agy-codex-cleanup/artifacts/review/design/codex/REVIEW.md", "required": true}]
    },
    {
      "id": "review_design_claude", "type": "review", "title": "Design review claude ergonomics_dx", "role_id": "reviewer", "lane_id": "claude_code",
      "parallel_group": "design_review", "fresh_session_required": true, "reviewer_context_policy": "fresh", "reviewer_access_scope": "document_only", "review_posture": "ergonomics_dx",
      "objective": "Review the synthesis for ergonomics/DX and interrogate the live synthesizer before a verdict.",
      "task_prompt": {"path": "prompts/review_design.md"},
      "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["docs/operator/workflows/rfc-0088-p2p3-agy-codex-cleanup/artifacts/review/design/claude_code/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "design_review_claude", "kind": "finding", "path": "docs/operator/workflows/rfc-0088-p2p3-agy-codex-cleanup/artifacts/review/design/claude_code/REVIEW.md", "required": true}]
    },
    {
      "id": "implement", "type": "build", "title": "Implement RFC 0088 P2+P3 (codex builder)", "role_id": "implementer", "lane_id": "codex",
      "required_review_postures": ["threat_model", "ergonomics_dx"],
      "objective": "Implement the synthesized scope in Go: P2 (canonical agy family + drop antigravity; agy installer reusing claude bundle; ephemeral MCP config injection covers agy; remove gemini_cli family + gemini_default profile + gemini installer + gemini lanes in workflow templates) THEN P3 (codex agent_loop wrap proven over PTY with submit; retire codex exec; DELETE the turn-driver + single_shot capability + the --print supervised wrapper). Land in two commits. Codex is the builder; gemini is not in any lane.",
      "task_prompt": {"path": "prompts/implement.md"},
      "write_scope": {"mode": "repo_write", "repo_write": true,
        "allowed_paths": ["go/", "docs/rfcs/", "docs/DECISION_LOG.md", "docs/UBIQUITOUS_LANGUAGE.md", "docs/TODO.md", "examples/", "docs/operator/workflows/conversation-3way/", "docs/operator/workflows/rfc-0088-p2p3-agy-codex-cleanup/artifacts/build/"],
        "forbidden_paths": [".striatum/", "docs/operator/workflows/rfc-0088-p2p3-agy-codex-cleanup/artifacts/design/", "docs/operator/workflows/rfc-0088-p2p3-agy-codex-cleanup/artifacts/review/"]},
      "expected_artifacts": [{"logical_name": "build_handoff", "kind": "handoff", "path": "docs/operator/workflows/rfc-0088-p2p3-agy-codex-cleanup/artifacts/build/HANDOFF.md", "required": true}]
    },
    {
      "id": "review_build_codex", "type": "review", "title": "Build review codex threat_model", "role_id": "reviewer", "lane_id": "codex",
      "parallel_group": "build_review", "fresh_session_required": true, "reviewer_context_policy": "fresh", "reviewer_access_scope": "document_only", "review_posture": "threat_model",
      "objective": "Threat-model the implementation; read the diff and HANDOFF; run verification commands; verdict.",
      "task_prompt": {"path": "prompts/review_build.md"},
      "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["docs/operator/workflows/rfc-0088-p2p3-agy-codex-cleanup/artifacts/review/build/codex/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "build_review_codex", "kind": "finding", "path": "docs/operator/workflows/rfc-0088-p2p3-agy-codex-cleanup/artifacts/review/build/codex/REVIEW.md", "required": true}]
    },
    {
      "id": "review_build_claude", "type": "review", "title": "Build review claude ergonomics_dx", "role_id": "reviewer", "lane_id": "claude_code",
      "parallel_group": "build_review", "fresh_session_required": true, "reviewer_context_policy": "fresh", "reviewer_access_scope": "document_only", "review_posture": "ergonomics_dx",
      "objective": "Review the implementation for ergonomics/DX; read the diff and HANDOFF; run verification commands; verdict.",
      "task_prompt": {"path": "prompts/review_build.md"},
      "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["docs/operator/workflows/rfc-0088-p2p3-agy-codex-cleanup/artifacts/review/build/claude_code/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "build_review_claude", "kind": "finding", "path": "docs/operator/workflows/rfc-0088-p2p3-agy-codex-cleanup/artifacts/review/build/claude_code/REVIEW.md", "required": true}]
    }
  ],
  "edges": [
    {"from": "design_codex", "to": "synth", "on": "completed"},
    {"from": "design_claude", "to": "synth", "on": "completed"},
    {"from": "synth", "to": "review_design_codex", "on": "completed"},
    {"from": "synth", "to": "review_design_claude", "on": "completed"},
    {"from": "review_design_codex", "to": "implement", "on": "completed"},
    {"from": "review_design_claude", "to": "implement", "on": "completed"},
    {"from": "implement", "to": "review_build_codex", "on": "completed"},
    {"from": "implement", "to": "review_build_claude", "on": "completed"}
  ],
  "cycles": [
    {"from": "review_design_codex", "to": "synth", "on_verdict": "needs_revision", "max_iterations": 2, "allow_same_lane": true},
    {"from": "review_design_claude", "to": "synth", "on_verdict": "needs_revision", "max_iterations": 2, "allow_same_lane": true},
    {"from": "review_build_codex", "to": "implement", "on_verdict": "needs_revision", "max_iterations": 2, "allow_same_lane": true},
    {"from": "review_build_claude", "to": "implement", "on_verdict": "needs_revision", "max_iterations": 2, "allow_same_lane": true}
  ]
}
