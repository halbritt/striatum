{
  "schema_version": "striatum.workflow.v1",
  "workflow_id": "f42-conversation-turn-driver",
  "workflow_version": "2026-05-26",
  "name": "F42: autonomous conversation turn-driver (design + build, interrogating panel)",
  "branch": {
    "mode": "confirm",
    "suggested_name": "striatum/f42-conversation-turn-driver",
    "allow_dirty": true
  },
  "coordinator": {
    "role_id": "coordinator",
    "lane_id": "claude_code"
  },
  "lanes": {
    "codex": {
      "adapter": "process",
      "display_model": "Codex",
      "command": ["codex", "exec", "-"],
      "capabilities": ["write", "review", "synthesis"]
    },
    "claude_code": {
      "adapter": "process",
      "display_model": "Claude",
      "command": ["claude", "--print"],
      "capabilities": ["write", "review", "synthesis"]
    }
  },
  "roles": {
    "coordinator": {"definition_path": "roles/coordinator.md"},
    "designer": {"definition_path": "roles/designer.md"},
    "synthesizer": {"definition_path": "roles/synthesizer.md"},
    "implementer": {"definition_path": "roles/implementer.md"},
    "reviewer": {"definition_path": "roles/reviewer.md"}
  },
  "context_docs": [
    {"path": "docs/operator/workflows/f42-conversation-turn-driver/TASK.md", "required": true},
    {"path": "README.md", "required": false}
  ],
  "parallelism": {
    "mode": "declared",
    "max_active_jobs": 2,
    "require_disjoint_write_scopes": true
  },
  "jobs": [
    {
      "id": "design_codex",
      "type": "draft",
      "title": "Design (codex lane)",
      "role_id": "designer",
      "lane_id": "codex",
      "parallel_group": "design",
      "fresh_session_required": true,
      "objective": "Produce an independent design proposal for the F42 turn-driver. Do not coordinate with the other design lane.",
      "task_prompt": {"path": "prompts/design.md"},
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": ["docs/operator/workflows/f42-conversation-turn-driver/artifacts/design/codex/"],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {"logical_name": "codex_design", "kind": "handoff", "path": "docs/operator/workflows/f42-conversation-turn-driver/artifacts/design/codex/DESIGN.md", "required": true}
      ]
    },
    {
      "id": "design_claude",
      "type": "draft",
      "title": "Design (claude_code lane)",
      "role_id": "designer",
      "lane_id": "claude_code",
      "parallel_group": "design",
      "fresh_session_required": true,
      "objective": "Produce an independent design proposal for the F42 turn-driver. Do not coordinate with the other design lane.",
      "task_prompt": {"path": "prompts/design.md"},
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": ["docs/operator/workflows/f42-conversation-turn-driver/artifacts/design/claude_code/"],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {"logical_name": "claude_design", "kind": "handoff", "path": "docs/operator/workflows/f42-conversation-turn-driver/artifacts/design/claude_code/DESIGN.md", "required": true}
      ]
    },
    {
      "id": "synth",
      "type": "synthesis",
      "title": "Synthesize designs (interrogable)",
      "role_id": "synthesizer",
      "lane_id": "claude_code",
      "fresh_session_required": true,
      "interrogable": true,
      "objective": "Reconcile the two design proposals into a single buildable synthesis. Stay live after completing so the design-review panel can interrogate your preserved reasoning.",
      "task_prompt": {"path": "prompts/synth.md"},
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": ["docs/operator/workflows/f42-conversation-turn-driver/artifacts/DESIGN_SYNTHESIS.md"],
        "forbidden_paths": [".striatum/", "docs/operator/workflows/f42-conversation-turn-driver/artifacts/design/"]
      },
      "expected_artifacts": [
        {"logical_name": "design_synthesis", "kind": "synthesis", "path": "docs/operator/workflows/f42-conversation-turn-driver/artifacts/DESIGN_SYNTHESIS.md", "required": true}
      ]
    },
    {
      "id": "review_design_codex",
      "type": "review",
      "title": "Design review codex threat_model",
      "role_id": "reviewer",
      "lane_id": "codex",
      "parallel_group": "design_review",
      "fresh_session_required": true,
      "reviewer_context_policy": "fresh",
      "reviewer_access_scope": "document_only",
      "review_posture": "threat_model",
      "objective": "Threat-model the design synthesis and interrogate the live synthesizer session before rendering a verdict.",
      "task_prompt": {"path": "prompts/review_design.md"},
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": ["docs/operator/workflows/f42-conversation-turn-driver/artifacts/review/design/codex/"],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {"logical_name": "design_review_codex", "kind": "finding", "path": "docs/operator/workflows/f42-conversation-turn-driver/artifacts/review/design/codex/REVIEW.md", "required": true}
      ]
    },
    {
      "id": "review_design_claude",
      "type": "review",
      "title": "Design review claude ergonomics_dx",
      "role_id": "reviewer",
      "lane_id": "claude_code",
      "parallel_group": "design_review",
      "fresh_session_required": true,
      "reviewer_context_policy": "fresh",
      "reviewer_access_scope": "document_only",
      "review_posture": "ergonomics_dx",
      "objective": "Review the design synthesis for ergonomics and developer experience, then interrogate the live synthesizer session before rendering a verdict.",
      "task_prompt": {"path": "prompts/review_design.md"},
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": ["docs/operator/workflows/f42-conversation-turn-driver/artifacts/review/design/claude_code/"],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {"logical_name": "design_review_claude", "kind": "finding", "path": "docs/operator/workflows/f42-conversation-turn-driver/artifacts/review/design/claude_code/REVIEW.md", "required": true}
      ]
    },
    {
      "id": "implement",
      "type": "build",
      "title": "Implement synthesized turn-driver (interrogable)",
      "role_id": "implementer",
      "lane_id": "codex",
      "interrogable": true,
      "required_review_postures": ["threat_model", "ergonomics_dx"],
      "objective": "Implement the synthesized turn-driver with tests. Land only the converged scope, write a handoff, and stay live so the build-review panel can interrogate your preserved reasoning.",
      "task_prompt": {"path": "prompts/implement.md"},
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "go/",
          "docs/rfcs/",
          "docs/DECISION_LOG.md",
          "docs/TODO.md",
          "docs/HOW_TO_AGENT.md",
          "docs/UBIQUITOUS_LANGUAGE.md",
          "docs/operator/workflows/conversation-3way/",
          "docs/operator/workflows/f42-conversation-turn-driver/artifacts/build/"
        ],
        "forbidden_paths": [
          ".striatum/",
          "docs/operator/workflows/f42-conversation-turn-driver/artifacts/design/",
          "docs/operator/workflows/f42-conversation-turn-driver/artifacts/review/"
        ]
      },
      "expected_artifacts": [
        {"logical_name": "build_handoff", "kind": "handoff", "path": "docs/operator/workflows/f42-conversation-turn-driver/artifacts/build/HANDOFF.md", "required": true}
      ]
    },
    {
      "id": "review_build_codex",
      "type": "review",
      "title": "Build review codex threat_model",
      "role_id": "reviewer",
      "lane_id": "codex",
      "parallel_group": "build_review",
      "fresh_session_required": true,
      "reviewer_context_policy": "fresh",
      "reviewer_access_scope": "document_only",
      "review_posture": "threat_model",
      "objective": "Threat-model the implementation and interrogate the live implementer session before rendering a verdict.",
      "task_prompt": {"path": "prompts/review_build.md"},
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": ["docs/operator/workflows/f42-conversation-turn-driver/artifacts/review/build/codex/"],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {"logical_name": "build_review_codex", "kind": "finding", "path": "docs/operator/workflows/f42-conversation-turn-driver/artifacts/review/build/codex/REVIEW.md", "required": true}
      ]
    },
    {
      "id": "review_build_claude",
      "type": "review",
      "title": "Build review claude ergonomics_dx",
      "role_id": "reviewer",
      "lane_id": "claude_code",
      "parallel_group": "build_review",
      "fresh_session_required": true,
      "reviewer_context_policy": "fresh",
      "reviewer_access_scope": "document_only",
      "review_posture": "ergonomics_dx",
      "objective": "Review the implementation for operator and developer ergonomics, run the verification commands, then interrogate the live implementer session before rendering a verdict.",
      "task_prompt": {"path": "prompts/review_build.md"},
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": ["docs/operator/workflows/f42-conversation-turn-driver/artifacts/review/build/claude_code/"],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {"logical_name": "build_review_claude", "kind": "finding", "path": "docs/operator/workflows/f42-conversation-turn-driver/artifacts/review/build/claude_code/REVIEW.md", "required": true}
      ]
    }
  ],
  "edges": [
    {"from": "design_codex", "to": "synth", "on": "completed"},
    {"from": "design_claude", "to": "synth", "on": "completed"},
    {"from": "synth", "to": "review_design_codex", "on": "completed"},
    {"from": "synth", "to": "review_design_claude", "on": "completed"},
    {"from": "review_design_codex", "to": "implement", "on": "completed"},
    {"from": "review_design_claude", "to": "implement", "on": "completed"},
    {"from": "implement", "to": "review_build_codex", "on": "completed"},
    {"from": "implement", "to": "review_build_claude", "on": "completed"}
  ],
  "cycles": [
    {"from": "review_design_codex", "to": "synth", "on_verdict": "needs_revision", "max_iterations": 2, "allow_same_lane": true},
    {"from": "review_design_claude", "to": "synth", "on_verdict": "needs_revision", "max_iterations": 2, "allow_same_lane": true},
    {"from": "review_build_codex", "to": "implement", "on_verdict": "needs_revision", "max_iterations": 2, "allow_same_lane": true},
    {"from": "review_build_claude", "to": "implement", "on_verdict": "needs_revision", "max_iterations": 2, "allow_same_lane": true}
  ]
}
