{
  "schema_version": "striatum.workflow.v1",
  "workflow_id": "rfc-0089-tmux-helper-redesign-rerun2",
  "workflow_version": "2026-05-28",
  "name": "RFC 0089: tmux helper redesign with three-model design, interrogation, codex build, and three-lane build review",
  "branch": {
    "mode": "confirm",
    "suggested_name": "striatum/rfc-0089-tmux-helper-redesign-rerun2",
    "allow_dirty": true
  },
  "coordinator": {"role_id": "coordinator", "lane_id": "claude_code"},
  "lanes": {
    "codex": {
      "adapter": "process",
      "display_model": "Codex GPT-5.5 xhigh",
      "command": ["codex", "--model", "gpt-5.5", "-c", "model_reasoning_effort=\"xhigh\"", "--dangerously-bypass-approvals-and-sandbox"],
      "adapter_capabilities": {"agent_loop": true},
      "capabilities": ["write", "review", "synthesis", "interrogate"]
    },
    "codex_builder": {
      "adapter": "process",
      "display_model": "Codex GPT-5.5 xhigh",
      "command": ["codex", "--model", "gpt-5.5", "-c", "model_reasoning_effort=\"xhigh\"", "--dangerously-bypass-approvals-and-sandbox"],
      "adapter_capabilities": {"agent_loop": true},
      "capabilities": ["write", "interrogate"]
    },
    "claude_code": {
      "adapter": "process",
      "display_model": "Claude Opus 4.7",
      "command": ["claude", "--model", "claude-opus-4-7", "--permission-mode", "bypassPermissions"],
      "adapter_capabilities": {"agent_loop": true},
      "capabilities": ["write", "review", "synthesis", "interrogate"]
    },
    "agy": {
      "adapter": "process",
      "display_model": "Gemini 3.5 Flash High",
      "command": ["sh", "-c", "IFS= read -r prompt; exec agy --dangerously-skip-permissions --print-timeout 30m --print \"$prompt\" </dev/null"],
      "supervision": {"transport": "pipe", "stdin_delivery": "one_shot_eof"},
      "capabilities": ["write", "review", "interrogate"]
    }
  },
  "roles": {
    "coordinator": {"definition_path": "roles/coordinator.md"},
    "designer": {"definition_path": "roles/designer.md"},
    "synthesizer": {"definition_path": "roles/synthesizer.md"},
    "implementer": {"definition_path": "roles/implementer.md"},
    "reviewer": {"definition_path": "roles/reviewer.md"}
  },
  "context_docs": [
    {"path": "docs/operator/workflows/rfc-0089-tmux-helper-redesign-rerun2/TASK.md", "required": true},
    {"path": "docs/rfcs/0089-tmux-backed-lane-monitoring.md", "required": true},
    {"path": "docs/rfcs/0088-deprecate-print-interactive-pty-lanes-agy-migration.md", "required": true},
    {"path": "docs/operator/workflows/rfc-0088-p3-codex-verify/FINDINGS.md", "required": false}
