        "forbidden_paths": [
          ".striatum/"
        ],
        "mode": "review_only_artifact",
        "repo_write": false
      }
    },
    {
      "expected_artifacts": [
        {
          "kind": "synthesis",
          "logical_name": "summary",
          "path": "docs/operator/artifacts/rfc-0162-build/SUMMARY.md",
          "placement": "git_publication",
          "required": true
        }
      ],
      "id": "apply",
      "lane_id": "author",
      "objective": "Finalize the reviewed MVP change; ensure go build/vet/test green and publish SUMMARY.md.",
