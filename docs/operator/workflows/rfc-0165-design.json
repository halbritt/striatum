      "role_id": "holder",
      "task_prompt": {
        "path": "prompts/collaboration_holder.md"
      },
      "title": "Hold leading proposal",
      "type": "build",
      "write_scope": {
        "allowed_paths": [
          "docs/operator/artifacts/rfc-0165-design/dialogue/holder/"
        ],
        "forbidden_paths": [
          ".striatum/"
        ],
        "mode": "repo_write",
        "repo_write": true
      }
    },
    {
      "expected_artifacts": [
        {
          "kind": "handoff",
          "logical_name": "falsifier_1",
          "path": "docs/operator/artifacts/rfc-0165-design/dialogue/falsifier_1/FALSIFIER.md",
          "placement": "git_publication",
          "required": true
        }
      ],
      "id": "falsifier_1",
      "lane_id": "reviewer",
      "objective": "Read the published holder proposal and write one material falsifying challenge for RFC 0165 and GH #583. Attack copy and verify races, hydrator path escape or privilege bridge, custody receipts event-vs-table choice, provider_auth_gate=off bypass, stale-auth vs ordinary MCP discovery classification, or missing redaction and test proof.",
