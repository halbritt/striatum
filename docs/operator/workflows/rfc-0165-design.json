    {
      "expected_artifacts": [
        {
          "kind": "handoff",
          "logical_name": "holder_handoff",
          "path": "docs/operator/artifacts/rfc-0165-design/dialogue/holder/HOLDER.md",
          "placement": "git_publication",
          "required": true
