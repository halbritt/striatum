      "role_id": "falsifier",
      "task_prompt": {
        "path": "prompts/collaboration_falsifier.md"
      },
      "title": "Falsifier 1",
      "type": "build",
      "write_scope": {
        "allowed_paths": [
          "docs/operator/artifacts/rfc-0165-design/dialogue/falsifier_1/"
        ],
        "forbidden_paths": [
          ".striatum/"
        ],
        "mode": "repo_write",
        "repo_write": true
      }
    },
    {
      "expected_artifacts": [
        {
          "kind": "handoff",
          "logical_name": "falsifier_2",
          "path": "docs/operator/artifacts/rfc-0165-design/dialogue/falsifier_2/FALSIFIER.md",
          "placement": "git_publication",
          "required": true
        }
      ],
      "id": "falsifier_2",
      "lane_id": "reviewer",
      "objective": "Read the published holder proposal and write one independent material falsifying challenge for RFC 0165 and GH #583. Prefer a different risk than falsifier_1 if possible: owner, mode, symlink handling, same-user collapse, multi-repo scoping, source generation instability, recovery reseed semantics, or operator remediation privacy.",
      "phase_id": "dialogue",
      "role_id": "falsifier",
      "task_prompt": {
        "path": "prompts/collaboration_falsifier.md"
      },
      "title": "Falsifier 2",
      "type": "build",
      "write_scope": {
        "allowed_paths": [
          "docs/operator/artifacts/rfc-0165-design/dialogue/falsifier_2/"
        ],
        "forbidden_paths": [
          ".striatum/"
        ],
        "mode": "repo_write",
        "repo_write": true
      }
    },
    {
      "expected_artifacts": [
        {
          "kind": "collaboration_ledger",
          "logical_name": "collaboration_ledger_${cycle}",
          "path": "docs/operator/artifacts/rfc-0165-design/dialogue/adjudicator/COLLABORATION_LEDGER_${cycle}.md",
          "placement": "git_publication",
          "required": true
        }
      ],
      "fresh_session_required": true,
      "id": "adjudicate",
      "lane_id": "author",
      "objective": "Read only the dialogue trajectory for RFC 0165 and GH #583 and publish the collaboration ledger verdict (one of accept, accept_with_findings, needs_revision, reject - a clearing verdict is accept or accept_with_findings, never `clear`). The ledger must decide whether the proposal resolves every required design decision and folds any material falsifier finding into a buildable implementation spec.",
      "phase_id": "dialogue",
      "role_id": "adjudicator",
      "task_prompt": {
        "path": "prompts/adjudicate_collaboration.md"
      },
      "title": "Adjudicate dialogue substance",
      "type": "phase_synthesis",
      "write_scope": {
        "allowed_paths": [
          "docs/operator/artifacts/rfc-0165-design/dialogue/adjudicator/"
        ],
        "forbidden_paths": [
          ".striatum/"
        ],
        "mode": "repo_write",
        "repo_write": true
      }
    },
    {
      "expected_artifacts": [
        {
          "kind": "synthesis",
          "logical_name": "commit_proposal",
          "path": "docs/operator/artifacts/rfc-0165-design/commit/proposal/PROPOSAL.md",
          "placement": "git_publication",
          "required": true
        }
      ],
      "id": "commit_proposal",
      "lane_id": "author",
      "objective": "Publish the cleared RFC 0165 implementation spec only after the adjudicator ledger records a clearing verdict. The proposal must be the artifact consumed by a later rfc-0165-build run and must name exact source surfaces, durable state, tests, and deferred work.",
