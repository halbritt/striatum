  "lanes": {
    "claude": {
      "adapter": "process",
      "command": ["bash", "-lc", "cat >/dev/null"],
      "model": "claude",
      "display_model": "Claude",
      "strategy_version": "2026-05-25",
      "constraints": {"network": "forbidden", "repo_scope": "local_only", "transcripts": "off"},
      "required_enforcement": {"network": "advisory_strict", "repo_scope": "advisory_strict", "transcripts": "enforced"},
      "supervision": {"compatible": true, "stdin_format": "newline_delimited_json", "wrapper_required": true}
    }
  },
  "roles": {
    "coordinator": {"description": "Operator coordinator."},
    "implementer": {"description": "Builder whose context is interrogated."},
    "reviewer": {"description": "Reviewer that interrogates the builder."}
  },
  "jobs": [
    {
      "id": "build", "type": "build", "title": "Build (interrogable)", "role_id": "implementer", "lane_id": "claude",
      "fresh_session_required": false, "interrogable": true,
      "objective": "Build work whose live context can be interrogated.",
      "task_prompt": {"inline": "Operator-driven demo build job."},
      "write_scope": {"mode": "repo_write", "repo_write": true, "allowed_paths": ["docs/operator/artifacts/interrogation-live-demo/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": []
    },
    {
      "id": "review", "type": "review", "title": "Review by interrogation", "role_id": "reviewer", "lane_id": "claude",
      "fresh_session_required": false,
      "reviewer_context_policy": "fresh", "reviewer_access_scope": "artifact_only", "review_posture": "neutral",
      "objective": "Interrogate the builder's preserved context.",
      "task_prompt": {"inline": "Operator-driven demo review job."},
      "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["docs/operator/artifacts/interrogation-live-demo/"], "forbidden_paths": []},
      "expected_artifacts": []
    }
  ],
  "edges": [{"from": "build", "to": "review", "on": "completed"}],
  "cycles": []
}
