{
    "schema_version": "striatum.workflow.v1",
    "workflow_id": "rfc-0103-w3-141-restart",
    "workflow_version": "2026-06-02",
    "name": "RFC 0103 W3 #141 daemon-restart survival (minimal single-lane repo-write)",
    "branch": {
        "mode": "confirm",
        "suggested_name": "striatum/rfc-0103-w3-141-restart",
        "allow_dirty": true
    },
    "coordinator": {
        "role_id": "author",
        "lane_id": "claude"
    },
    "lanes": {
        "claude": {
            "adapter": "process",
            "display_model": "Claude Opus 4.8",
            "command": [
                "claude",
                "--dangerously-skip-permissions",
                "--model",
                "claude-opus-4-8"
            ],
            "adapter_capabilities": {
                "agent_loop": true
            },
            "supervision": {
                "transport": "pty_helper",
                "compatible": true,
                "require_tmux": true
            },
            "capabilities": [
                "write",
                "review"
            ]
        }
    },
    "roles": {
        "author": {
            "definition_path": "roles/author.md"
        }
    },
    "context_docs": [],
    "parallelism": {
        "mode": "declared",
        "max_active_jobs": 1,
        "require_disjoint_write_scopes": true
    },
    "jobs": [
        {
            "id": "write_restart_proof",
            "type": "draft",
            "title": "Write RFC 0103 W3 #141 daemon-restart survival note",
            "role_id": "author",
            "lane_id": "claude",
            "objective": "Author a short markdown note proving a supervised lane survived a mid-run daemon restart and completed through the live daemon.",
            "task_prompt": {
                "path": "prompts/write_restart_proof.md"
            },
            "write_scope": {
                "mode": "repo_write",
                "repo_write": true,
                "allowed_paths": [
                    "docs/dogfoods/rfc-0103-w3-141-restart/artifacts/"
                ],
                "forbidden_paths": [
                    ".striatum/"
                ]
            },
            "expected_artifacts": [
                {
                    "logical_name": "restart_survival_proof",
                    "kind": "handoff",
                    "path": "docs/dogfoods/rfc-0103-w3-141-restart/artifacts/RESTART_SURVIVAL_PROOF.md",
                    "required": true
                }
            ]
        }
    ],
    "edges": [],
    "cycles": []
}
