{
    "schema_version": "striatum.workflow.v1",
    "workflow_id": "rfc-0109-agy-seat",
    "workflow_version": "2026-06-03",
    "name": "RFC 0109 — 3-lane interrogating panel proving the agy seat holds across a needs_revision cycle",
    "branch": {
        "mode": "confirm",
        "suggested_name": "striatum/rfc-0109-agy-seat",
        "allow_dirty": true
    },
    "coordinator": {
        "role_id": "presenter",
        "lane_id": "claude"
    },
    "allow_same_model_review_pairing": true,
    "lanes": {
        "claude": {
            "adapter": "process",
            "display_model": "Claude Opus 4.8",
            "command": [
                "claude",
                "--dangerously-skip-permissions",
                "--model",
                "claude-opus-4-8"
            ],
            "adapter_capabilities": {
                "agent_loop": true
            },
            "supervision": {
                "transport": "pty_helper",
                "compatible": true,
                "require_tmux": true
            },
            "capabilities": [
                "write",
                "review",
                "interrogate"
            ]
        },
        "codex": {
            "adapter": "process",
            "display_model": "OpenAI Codex (gpt-5.5)",
            "command": [
                "codex"
            ],
            "adapter_capabilities": {
                "agent_loop": true
            },
            "supervision": {
                "transport": "pty_helper",
                "compatible": true,
                "require_tmux": true
            },
            "capabilities": [
                "review",
                "interrogate"
            ]
        },
        "agy": {
            "adapter": "process",
            "display_model": "Antigravity (gemini)",
            "command": [
                "agy",
                "--dangerously-skip-permissions"
            ],
            "adapter_capabilities": {
                "agent_loop": true
            },
            "supervision": {
                "transport": "pty_helper",
                "compatible": true,
                "require_tmux": true
            },
            "capabilities": [
                "review",
                "interrogate"
            ]
        }
    },
    "roles": {
        "presenter": {
            "definition_path": "roles/presenter.md"
        },
        "reviewer": {
            "definition_path": "roles/reviewer.md"
        }
    },
    "context_docs": [],
    "parallelism": {
        "mode": "declared",
        "max_active_jobs": 2,
        "require_disjoint_write_scopes": true
    },
    "jobs": [
        {
            "id": "present",
            "type": "synthesis",
            "title": "Author the RFC 0109 agy-seat panel synthesis note",
            "role_id": "presenter",
            "lane_id": "claude",
            "interrogable": true,
            "objective": "Author a short markdown synthesis describing why the agy seat must hold across a revision cycle (the #139 inverse); revise once when the agy reviewer requires it.",
            "task_prompt": {
                "path": "prompts/present.md"
            },
            "write_scope": {
                "mode": "repo_write",
                "repo_write": true,
                "allowed_paths": [
                    "docs/dogfoods/rfc-0109-agy-seat/artifacts/"
                ],
                "forbidden_paths": [
                    ".striatum/"
                ]
            },
            "expected_artifacts": [
                {
                    "logical_name": "panel_synthesis",
                    "kind": "synthesis",
                    "path": "docs/dogfoods/rfc-0109-agy-seat/artifacts/PANEL_SYNTHESIS.md",
                    "required": true
                }
            ]
        },
        {
            "id": "review_codex",
            "type": "review",
            "title": "Codex: interrogate the presenter and review the panel synthesis (second independent voice)",
            "role_id": "reviewer",
            "lane_id": "codex",
            "review_posture": "neutral",
            "fresh_session_required": true,
            "objective": "Interrogate the presenter once, then accept — the third voice that proves the panel is genuinely 3-lane, not 2.",
            "task_prompt": {
                "path": "prompts/review.md"
            },
            "write_scope": {
                "mode": "review_only_artifact",
                "repo_write": false,
                "allowed_paths": [
                    "docs/dogfoods/rfc-0109-agy-seat/artifacts/"
                ],
                "forbidden_paths": [
                    ".striatum/"
                ]
            }
        },
        {
            "id": "review_agy",
            "type": "review",
            "title": "agy: interrogate the presenter and drive the needs_revision cycle (the seat-survival proof)",
            "role_id": "reviewer",
            "lane_id": "agy",
            "review_posture": "devils_advocate",
            "fresh_session_required": true,
            "objective": "Interrogate the presenter, vote needs_revision on attempt 1 with one concrete finding, then re-review the revised synthesis on attempt 2 and accept — the agy seat MUST survive the revision (the #95/#139 inverse).",
            "task_prompt": {
                "path": "prompts/review.md"
            },
            "write_scope": {
                "mode": "review_only_artifact",
                "repo_write": false,
                "allowed_paths": [
                    "docs/dogfoods/rfc-0109-agy-seat/artifacts/"
                ],
                "forbidden_paths": [
                    ".striatum/"
                ]
            }
        }
    ],
    "edges": [
        {
            "from": "present",
            "to": "review_codex",
            "on": "completed"
        },
        {
            "from": "present",
            "to": "review_agy",
            "on": "completed"
        }
    ],
    "cycles": [
        {
            "from": "review_agy",
            "to": "present",
            "on_verdict": "needs_revision",
            "max_iterations": 1,
            "allow_same_lane": true
        }
    ]
}
