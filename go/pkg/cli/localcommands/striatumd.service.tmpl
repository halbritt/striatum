[Unit]
Description=Striatum local workflow daemon (Go)
Documentation=https://github.com/halbritt/striatum
After=network-online.target

[Service]
Type=simple
# striatumd is installed by `make install` / `striatum daemon install`.
# The Postgres DSN is read from ~/.config/striatum/daemon.toml (postgres_url),
# or overridden with the STRIATUM_DAEMON_DB_URL environment variable.
# %h = user home, %t = per-user runtime directory (XDG_RUNTIME_DIR); using
# specifiers keeps this unit host-portable with no hardcoded home paths.
ExecStartPre=/usr/bin/mkdir -p %t/striatum
ExecStartPre=/usr/bin/chmod 0700 %t/striatum
ExecStart=%h/.local/bin/striatumd -socket %t/striatum/daemon-go.sock
Restart=on-failure
RestartSec=2
# A malformed config (e.g. an invalid STRIATUM_BLOB_* value, a bad
# --pg-write-boundary, or a missing/unparseable Postgres URL) is deterministic:
# restarting cannot fix it, and Restart=on-failure would otherwise turn a config
# typo into a tight crash loop. striatumd validates its config before any side
# effect and exits 78 (BSD EX_CONFIG) on a config error; RestartPreventExitStatus
# tells systemd NOT to auto-restart that exit, so the daemon parks in `failed`
# with the exact error in `systemctl --user status` instead of looping. Transient
# failures (database briefly unreachable, stale socket) keep their non-78 exit and
# still auto-restart. Run `striatumd -check-config` to validate before a restart.
#
# RFC 0142 Layer 2 (owner-bundle watermark interlock): exit 79 is the
# awaiting_owner_ddl halt — the applied owner-bundle watermark is below the
# frontier this binary requires, so a runtime migration that depends on the
# pending owner DDL would crash-loop the single writer (#442 / D248). It is the
# same deterministic, restart-won't-fix shape as a config error: the operator must
# apply the pending owner bundle out-of-band (`striatum daemon owner-ddl apply`)
# before restarting onto the new binary. Listing 79 here parks the daemon in
# `failed` with the remediation in `systemctl --user status` (apoptosis) instead
# of force-committing a half-applied deploy and thrashing.
RestartPreventExitStatus=78 79
# RFC 0103 W3 (#141): a daemon restart must not orphan supervised lane helpers.
# The default KillMode=control-group SIGKILLs the whole service cgroup on
# stop/restart, taking down the Setsid-detached supervisor helpers (and their
# tmux-backed agent lanes) even though the restart only means to replace the
# daemon process. KillMode=process signals ONLY the main daemon process, so a
# restart (and an on-failure auto-restart) leaves the helpers, tmux sessions, and
# agent lanes running: the helper bridges over files (event log + packet FIFO),
# not the daemon socket, and the agent-loop receiver re-dials the recreated
# socket on its next poll, so delivery resumes with no rebind needed. A hard
# cgroup kill (systemctl kill / OOM) that still takes a helper is recovered by
# the on-demand `supervise rebridge` verb.
KillMode=process

[Install]
WantedBy=default.target
