      "recommended_for": ["partial-context reconstruction checks", "constraint-coverage adjudication", "deliberately-withheld-context design reviews"],
      "default_lane_sets": ["multi_review", "author_reviewer", "local"],
      "required_options": ["workflow_id", "artifact_root", "topic"],
      "generation_status": "generated",
      "shape_family": "collaboration",
